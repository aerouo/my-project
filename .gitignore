# =========================================================================
# Unity Standard Gitignore
# =========================================================================

# 絕對不要進 Git 的主要快取與暫存資料夾（直接用全域比對，更安全）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.utmp/

# 記憶體與錄影檔案
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE 產生的快取與設定檔
.vs/
.gradle/
.idea/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 自動產生的 Meta 雜訊
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# 建置出來的產物
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables 暫存
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# OS 產生的雜訊
.DS_Store
Thumbs.db
