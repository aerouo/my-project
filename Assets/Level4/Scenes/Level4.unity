  m_Script: {fileID: 11500000, guid: 7b222c773df3a734c81197d22dee9941, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level1Manager
  dialogueText: {fileID: 835394274}
  backgroundImage: {fileID: 384862595}
  storyPart1: "\u98FD\u9910\u4E00\u9813\u5F8C\uFF0C\u4F60\u7684\u9AD4\u529B\u9010\u6F38\u6062\u5FA9\u3002\n\u4F60\u671B\u5411\u5F77\u5F7F\u7121\u76E1\u7684\u6D77\uFF0C\u9060\u8655\u90A3\u7247\u88AB\u8FF7\u9727\u7C60\u7F69\u7684\u6D77\u9762\uFF0C\u4F3C\u4E4E\u662F\u4F60\u552F\u4E00\u80FD\u96E2\u958B\u9019\u5EA7\u8A6D\u7570\u5CF6\u5DBC\u7684\u8DEF\u5F91\u3002\r\n\u6A58\u5B50\u76AE\u50CF\u662F\u770B\u7A7F\u4E86\u4F60\u7684\u5FC3\u601D\uFF0C\u4ED6\u5F9E\u7246\u89D2\u7FFB\u51FA\u4E00\u5F35\u7834\u820A\u7684\u5C0F\u8239\u8349\u5716\u3002\r\n\u200B\u6A58\u5B50\u76AE\uFF1A\u300C\u5982\u679C\u4F60\u60F3\u8D70\uFF0C\u6211\u5011\u9700\u8981\u4E00\u8258\u8239\uFF0C\u53EF\u6750\u6599\u9084\u662F\u9700\u8981\u6311\u9078\u4E00\u4E0B\u3002\u300D\r\n\n[\u63DB\u5716]\n\r\n\u4F60\u5011\u53C8\u56DE\u5230\u68EE\u6797\u3002\u9019\u88E1\u6563\u843D\u8457\u5404\u7A2E\u5927\u5C0F\u4E0D\u4E00\u7684\u6728\u6750\u3002\r\n"
  storyPart2: "\u62CD\u6389\u624B\u4E0A\u7684\u6CE5\u571F\uFF0C\u4F60\u548C\u6A58\u5B50\u76AE\u5408\u529B\u628A\u6C89\u7538\u7538\u7684\u6728\u6750\u8207\u5F37\u97CC\u7684\u690D\u7269\u7E96\u7DAD\u7E69\u7D22\u62D6\u56DE\u4E86\u5C0F\u5C4B\u65C1\u3002\r\n\u200B\u200B\u6A58\u5B50\u76AE\uFF1A\u300C\u5225\u64D4\u5FC3\uFF01\u53EA\u8981\u7167\u8457\u5716\u7D19\uFF0C\u6211\u5011\u5C31\u80FD\u9020\u8239\uFF01\u300D\r\n\r\n\u4F60\u6E4A\u904E\u53BB\u770B\u90A3\u5F35\u6CDB\u9EC3\u7684\u8A2D\u8A08\u5716\uFF0C\u4E0A\u9762\u6C92\u6709\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u5DE5\u7A0B\u5716\uFF0C\u53CD\u800C\u53EA\u6709\u4E00\u4E32\u898F\u5F8B\u7684\u795E\u79D8\u7B26\u865F\uFF1A\r\n"
  typingSpeed: 0.05
  waitBeforeStory: 0.5
  timeBetweenLines: 1.5
