--- !u!114 &1915700029
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1915700027}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 79868ffec23e11549922a6f618252cdb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level1Manager
  dialogueText: {fileID: 835394274}
  backgroundImage: {fileID: 384862595}
  storyPart1: "\u4F60\u5011\u5408\u529B\u5C07\u9020\u597D\u7684\u6728\u8239\u63A8\u5165\u6D77\u4E2D\u3002
    \u96D6\u7136\u6D77\u9762\u4E0A\u6F02\u6D6E\u8457\u6DE1\u6DE1\u7684\u9727\u6C23\uFF0C\u4F46\u591A\u8667\u4E86\u5C0F\u8239\uFF0C\u9084\u662F\u7A69\u7A69\u5730\u5C07\u4F60\u5011\u6258\u4F4F\u3002\r\n\u4F60\u8207\u6A58\u5B50\u76AE\u4E00\u4EBA\u62FF\u8457\u4E00\u652F\u6728\u69F3\uFF0C\u958B\u59CB\u7528\u529B\u5411\u5916\u6D77\u5212\u53BB\u3002\r\n\u4E00\u958B\u59CB\uFF0C\u4F60\u5011\u6EFF\u61F7\u5E0C\u671B\u3002\n\u4F46\u96A8\u8457\u6642\u9593\u4E00\u5206\u4E00\u79D2\u904E\u53BB\uFF0C\u56DB\u5468\u9664\u4E86\u7121\u908A\u7121\u969B\u7684\u8FF7\u9727\u8207\u6B7B\u5BC2\u7684\u6D77\u6D6A\uFF0C\u4EC0\u9EBC\u90FD\u6C92\u6709\u3002\n\u5CF6\u5DBC\u7684\u8F2A\u5ED3\u6F38\u6F38\u6D88\u5931\u5728\u8EAB\u5F8C\uFF0C\u524D\u65B9\u4F9D\u7136\u662F\u4E00\u7247\u672A\u77E5\u3002\r\n\u6A58\u5B50\u76AE\uFF1A\u300C\u547C\u2026\u2026\u547C\u2026\u2026\u6211\u3001\u6211\u5FEB\u5212\u4E0D\u52D5\u4E86\u2026\u2026\u300D
    \n\u6A58\u5B50\u76AE\u5C0F\u5C0F\u7684\u8EAB\u8EC0\u7671\u5750\u5728\u8239\u8259\u88E1\uFF0C\u539F\u672C\u7CBE\u795E\u6296\u64FB\u7684\u5C3E\u5DF4\u7121\u529B\u5730\u5782\u5728\u7532\u677F\u4E0A\uFF0C\u96D9\u624B\u56E0\u70BA\u9577\u6642\u9593\u63E1\u8457\u6728\u69F3\u800C\u78E8\u51FA\u4E86\u6C34\u6CE1\u3002\r\n
    \u4F60\u505C\u4E0B\u52D5\u4F5C\uFF0C\u5927\u53E3\u5598\u8457\u7C97\u6C23\u3002\u808C\u8089\u9178\u75DB\u5F97\u50CF\u8981\u6495\u88C2\u958B\u4F86\uFF0C\u9AD4\u529B\u5DF2\u7D93\u5FB9\u5E95\u900F\u652F\u3002
    \n\u9019\u7247\u6D77\u57DF\u6BD4\u60F3\u50CF\u4E2D\u9084\u8981\u5927\uFF0C\u5149\u9760\u4F60\u5011\u5169\u500B\u4EBA\u7684\u529B\u6C23\uFF0C\u6839\u672C\u4E0D\u53EF\u80FD\u6E38\u5230\u5C0D\u5CB8\u3002\n\n[\u63DB\u5716]\n\r\n\u5C31\u5728\u4F60\u611F\u5230\u7D55\u671B\u3001\u8FF7\u9727\u8D8A\u4F86\u8D8A\u6FC3\u7684\u6642\u5019\uFF0C\u9060\u65B9\u7684\u5929\u969B\u7DDA\u9802\u7AEF\uFF0C\u7A81\u7136\u96B1\u7D04\u9583\u904E\u4E86\u4E00\u9053\u5DE8\u5927\u7684\u9ED1\u5F71\uFF01\r\n\u90A3\u662F\u4E00\u8258\u8DEF\u904E\u7684\u5927\u8239\uFF01\u4F46\u8DDD\u96E2\u592A\u9060\u4E86\uFF0C\u5C0D\u65B9\u7684\u822A\u7DDA\u6B63\u5728\u7DE9\u6162\u9060\u96E2\u3002\r\n\u4F60\uFF1A\u300C\u6A58\u5B50\u76AE\uFF01\u5FEB\u770B\uFF01\u90A3\u88E1\u6709\u8239\uFF01\u300D\r\n"
  storyPart2: "[\u63DB\u5716]\n\n\u9583\u4EAE\u4EAE\u611B\u5FC3\u5929\u4F7F\u865F\u807D\u898B\u4E86\u4F60\u5011\u7684\u547C\u6551\uFF0C\u4F46\u6015\u5C0F\u8239\u7D93\u4E0D\u4F4F\u6FC0\u8D77\u7684\u6D6A\u6F6E\uFF0C\u6700\u5F8C\u4E00\u54E9\u8DEF\uFF0C\u9700\u8981\u4F60\u5011\u81EA\u5DF1\u8D70\u5B8C\u3002\r\n"
  typingSpeed: 0.05
  waitBeforeStory: 0.5
  timeBetweenLines: 1.5
  scene1: {fileID: 21300000, guid: 655ed76fcb51f1c4f9a866c5b10bd5c9, type: 3}
  scene2: {fileID: 21300000, guid: 35bfae6e997ec964f90b1dfc8395db8b, type: 3}
  scene3: {fileID: 21300000, guid: 92976ff512ce7e942942d6a8bf71f954, type: 3}
