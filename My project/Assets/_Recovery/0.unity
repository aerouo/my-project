  m_Script: {fileID: 11500000, guid: b14c787e34fae5c40b47d594c5e8e631, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level1Manager
  dialogueText: {fileID: 835394274}
  storyContent: "\u4F60\u6162\u6162\u775C\u958B\u96D9\u773C\u3002\n\u523A\u773C\u7684\u767D\u5149\u5F9E\u982D\u9802\u9583\u720D\u7684\u71C8\u689D\u7051\u4E0B\u4F86\uFF0C\u4EAE\u6697\u4EA4\u66FF\uFF0C\u50CF\u547C\u5438\u822C\u4E0D\u898F\u5F8B\u3002\n\u6620\u5165\u773C\u7C3E\u7684\u662F\u7834\u820A\u7684\u6A5F\u5668\u5916\u6BBC\uFF0C\u93FD\u8755\u7684\u91D1\u5C6C\u7E2B\u9699\u4E2D\u4F38\u51FA\u4E00\u675F\u675F\u88F8\u9732\u7684\u96FB\u7DDA\uFF0C\u5076\u723E\u4F34\u96A8\u96FB\u6D41\u7AC4\u52D5\u7684\u300C\u6ECB\u2014\u2014\u300D\u8072\uFF0C\u8B93\u4F60\u5FC3\u88E1\u5347\u8D77\u83AB\u540D\u7684\u4E0D\u5B89\u3002\n\n\u4F60\u6DF1\u5438\u4E00\u53E3\u6C23\uFF0C\u80F8\u8154\u50CF\u662F\u5361\u8457\u7802\u792B\u822C\u75BC\u75DB\u3002\n\u4F60\u6162\u6162\u6490\u8D77\u8EAB\u5B50\uFF0C\u52D5\u4F5C\u6C89\u91CD\uFF0C\u5C31\u50CF\u4E00\u5177\u9577\u5E74\u672A\u4FDD\u990A\u7684\u6A5F\u68B0\u6B63\u5728\u5F37\u884C\u555F\u52D5\u3002\u6BCF\u4E00\u6B21\u547C\u5438\u8207\u79FB\u52D5\uFF0C\u90FD\u5F77\u5F7F\u6703\u628A\u4F60\u62C6\u6563\u4F3C\u7684\u3002\n\n\u7576\u8996\u7DDA\u9010\u6F38\u6E05\u6670\uFF0C\u4F60\u624D\u767C\u73FE\u81EA\u5DF1\u6B63\u8EBA\u5728\u4E00\u500B\u50CF\u592A\u7A7A\u8259\u7684\u900F\u660E\u81A0\u56CA\u88E1\u3002\u8259\u9580\u534A\u6380\uFF0C\u900F\u660E\u7F69\u4E0A\u8986\u6EFF\u9727\u6C23\u8207\u522E\u75D5\uFF0C\u5F77\u5F7F\u66FE\u7D93\u6709\u4EC0\u9EBC\u4EBA\u2014\u2014\u6216\u4EC0\u9EBC\u6771\u897F\u2014\u2014\u8A66\u5716\u5F9E\u88E1\u982D\u62FC\u547D\u6293\u51FA\u4F86\u3002\n\n\u81A0\u56CA\u4E0A\u65B9\u539F\u672C\u8CBC\u8457\u4E00\u5F35\u6A19\u7C64\uFF0C\u537B\u88AB\u7C97\u66B4\u5730\u6495\u6389\uFF0C\u53EA\u7559\u4E0B\u7834\u788E\u7684\u7D19\u5C51\u548C\u81A0\u75D5\u3002\u4F46\u5176\u4E2D\u9084\u6B98\u7559\u5E7E\u500B\u5B57\u6BCD\u8207\u6578\u5B57\uFF1A\n\n\u300Chum-001\u300D\n\n\u4F60\u76EF\u8457\u9019\u7D44\u7DE8\u865F\uFF0C\u5FC3\u8DF3\u83AB\u540D\u52A0\u5FEB\u2014\u2014\n\u90A3\u4E0D\u50CF\u662F\u7269\u54C1\u7684\u5E8F\u865F\uFF0C\u66F4\u50CF\u662F\u4E00\u500B\u300C\u4F60\u300D\u7684\u540D\u5B57\u3002\n\n\u56DB\u5468\u4E00\u7247\u5BC2\u975C\uFF0C\u53EA\u6709\u6A5F\u68B0\u904B\u8F49\u5230\u58DE\u6B7B\u908A\u7DE3\u7684\u4F4E\u9CF4\u8072\u3002\u4F60\u6C7A\u5B9A\u53BB\u627E\u4E00\u4E9B\u7DDA\u7D22\u3002"
  typingSpeed: 0.05
  waitBeforeStory: 12
  timeBetweenLines: 1.5
