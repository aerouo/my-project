--- !u!114 &1915700029
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1915700027}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b14c787e34fae5c40b47d594c5e8e631, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level1Manager
  dialogueText: {fileID: 835394274}
  backgroundImage: {fileID: 384862595}
  storyPart1: "\u525B\u71C3\u8D77\u7684\u5E0C\u671B\u77AC\u9593\u7184\u6EC5\u3002\r\n\u4F60\u7626\u5F31\u3001\u75B2\u618A\u7684\u8EAB\u9AD4\u518D\u4E5F\u652F\u6490\u4E0D\u4F4F\uFF0C\u80CC\u810A\u8CBC\u8457\u51B0\u51B7\u7684\u5100\u5668\uFF0C\u4E00\u5BF8\u5BF8\u6ED1\u5750\u5230\u5730\u9762\u3002\r\n\u660F\u6697\u7684\u7A7A\u9593\u5145\u6EFF\u4E86\u91D1\u5C6C\u8150\u8755\u7684\u5473\u9053\uFF0C\u9084\u593E\u96DC\u8457\u5FAE\u5F31\u7684\u81ED\u6C27\u6C23\u606F\u2014\u2014\u50CF\u662F\u67D0\u7A2E\u5371\u96AA\u6B63\u5728\u56DB\u5468\u8513\u5EF6\u3002\r\n\r\n\u4F60\u62B1\u8457\u81EA\u5DF1\u7684\u96D9\u81C2\uFF0C\u8996\u7DDA\u4E00\u7247\u6A21\u7CCA\u3002\r\n\u4F60\u4E0D\u77E5\u9053\u81EA\u5DF1\u662F\u8AB0\uFF0C\u4E0D\u77E5\u9053\u70BA\u4EC0\u9EBC\u6703\u51FA\u73FE\u5728\u9019\u500B\u7834\u6557\u7684\u5BE6\u9A57\u8259\u3002\r\n\u80F8\u53E3\u8D8A\u4F86\u8D8A\u7DCA\uFF0C\u773C\u7736\u88E1\u9010\u6F38\u7A4D\u6EFF\u4E86\u6DDA\u3002\r\n\r\n\u5C31\u5728\u4F60\u5373\u5C07\u88AB\u6050\u61FC\u541E\u566C\u6642\u2014\u2014\r\n\u8EAB\u65C1\u50B3\u4F86\u7D30\u788E\u7684\u78B0\u649E\u8072\u3002\r\n\u7576\u9ED1\u5F71\u9760\u8FD1\u6642\uFF0C\u4F60\u56E0\u70BA\u6975\u5EA6\u6050\u614C\uFF0C\u8166\u6D77\u4E2D\u7A81\u7136\u70B8\u88C2\u958B\u4E00\u4E9B\u4E0D\u5C6C\u65BC\u4F60\u7684\u756B\u9762\u2014\u2014\u50CF\u662F\u65B7\u88C2\u7684\u8D70\u5ECA\u3001\u6643\u52D5\u7684\u71C8\u5149\u3002\u4F60\u5FC5\u9808\u5728\u610F\u8B58\u5D29\u6F70\u524D\uFF0C\u5C07\u9019\u4E9B\u6DF7\u4E82\u7684\u8996\u89BA\u788E\u7247\u7406\u6E05\u695A\u3002"
  storyPart2: "\u4F60\u7ACB\u523B\u8B66\u89BA\uFF0C\u986B\u6296\u8457\u64BF\u8D77\u8EAB\u908A\u4E00\u7247\u7834\u788E\u7684\u91D1\u5C6C\u677F\uFF0C\u8209\u5728\u80F8\u524D\u7576\u4F5C\u4FDD\u8B77\u3002\r\n\u9ED1\u5F71\u5728\u660F\u6697\u7684\u8D70\u5ECA\u76E1\u982D\u6643\u52D5\uFF0C\u4E00\u6B65\u4E00\u6B65\u9760\u8FD1\u4F60\u3002\r\n\r\n\u4F60\uFF1A\u300C\u5225\u904E\u4F86\uFF01\u300D\r\n\r\n\u9ED1\u5F71\u505C\u4F4F\u4E86\u3002\r\n\u63A5\u8457\uFF0C\u4E00\u96BB\u5713\u6EFE\u6EFE\u3001\u6BDB\u8338\u8338\u7684\u6A58\u8272\u8033\u6735\u5F9E\u5EE2\u68C4\u592A\u7A7A\u8259\u5F8C\u63A2\u4E86\u51FA\u4F86\u3002\r\n\n[\u63DB\u5716]\n\r\n\u4F60\uFF1A\u300C\u6B38\u2026\u2026\uFF1F\u72D0\u72F8\uFF1F\u300D\r\n\r\n\u90A3\u96BB\u300C\u72D0\u72F8\u300D\u602F\u751F\u751F\u5730\u6253\u91CF\u4F60\uFF0C\u773C\u775B\u5713\u5713\u5730\uFF0C\u50CF\u662F\u5728\u78BA\u8A8D\u4EC0\u9EBC\u3002\r\n\u4F60\u653E\u8F15\u8173\u6B65\u9760\u8FD1\uFF0C\u4ED6\u4E5F\u8DDF\u8457\u5F80\u524D\uFF0C\u5C0F\u5FC3\u7FFC\u7FFC\u3001\u6B65\u4F10\u4E00\u81F4\u3002\r\n\r\n\u76F4\u5230\u4ED6\u8D70\u5230\u5FAE\u5F31\u7684\u5149\u6E90\u4E0B\u2014\u2014\u4F60\u7D42\u65BC\u770B\u6E05\u4E86\u4ED6\u7684\u81C9\u3002\r\n\r\n\u4F60\u5012\u62BD\u4E00\u53E3\u6C23\uFF0C\u672C\u80FD\u5730\u6342\u4F4F\u5634\u3002\r\n\r\n\u4F60\uFF1A\u300C\u4F60\u662F\u6A5F\u5668\u4EBA\uFF01\u300D\r\n\r\n\r\n???\uFF1A\u300C\u6211\u4E0D\u662F\u2026\u2026\u300D\r\n\u4ED6\u7ACB\u523B\u4F4E\u4E0B\u982D\uFF0C\u624B\u6342\u8457\u81EA\u5DF1\u53F3\u534A\u908A\u7684\u91D1\u5C6C\u81C9\u9830\u3002\r\n\u90A3\u908A\u7684\u76AE\u819A\u662F\u5149\u6ED1\u5408\u91D1\uFF0C\u4ED6\u773C\u89D2\u6CDB\u8457\u6DDA\u5149\uFF0C\u8072\u97F3\u8F15\u5F97\u50CF\u8033\u8A9E\u3002\r\n\r\n\u4F60\uFF1A\u300C\u5C0D\u4E0D\u8D77\u2026\u2026\u6211\u4E0D\u662F\u90A3\u500B\u610F\u601D\uFF0C\u6211\u53EA\u662F\u5687\u5230\u4E86\u3002\u300D\r\n\u4F60\u9072\u7591\u4E86\u4E00\u79D2\uFF0C\u9084\u662F\u4F38\u624B\u6478\u4E86\u6478\u4ED6\u982D\u9802\u3002\r\n\u6EAB\u6696\u3002\r\n\u67D4\u8EDF\u3002\r\n\u610F\u5916\u5730\u5F88\u50CF\u771F\u7684\u72D0\u72F8\u3002\r\n\r\n\u4F60\u7DCA\u7E43\u7684\u80A9\u8180\u9019\u624D\u6162\u6162\u653E\u4E0B\u3002\r\n\r\n\u4F60\uFF1A\u300C\u4F60\u53EB\u4EC0\u9EBC\u540D\u5B57\uFF1F\u300D\r\n\r\n\r\n???\uFF1A\u300C\u6211\u53EB\u2026\u2026\u6A58\u5B50\u76AE\u3002\u300D\r\n\u4ED6\u62AC\u8D77\u4EAE\u6676\u6676\u7684\u773C\u775B\u3002\n\u6A58\u5B50\u76AE\uFF1A\u300C\u9019\u88E1\u5F88\u5371\u96AA\uFF0C\u5FEB\u8DDF\u6211\u8D70\uFF01\u300D\r\n\n[\u63DB\u5716]\n\r\n\u4F60\u8DDF\u8457\u6A58\u5B50\u76AE\u7A7F\u904E\u873F\u8712\u7684\u7BA1\u7DDA\u5806\uFF0C\u518D\u5F80\u4E0A\u4E00\u5C64\u722C\uFF0C\u4F86\u5230\u4ED6\u85CF\u8EAB\u7684\u5C0F\u5C4B\u3002\r\n\u5C4B\u88E1\u5806\u6EFF\u62FE\u4F86\u7684\u96F6\u4EF6\u3001\u5DE5\u5177\uFF0C\u4EE5\u53CA\u5360\u6EFF\u6574\u9762\u7246\u7684\u7DDA\u7D22\u5730\u5716\u3002\r\n\r\n\u90A3\u4E9B\u7D19\u5F35\u4E0A\u5BEB\u8457\u5927\u91CF\u7B26\u865F\u3001\u7DE8\u78BC\u3001\u6642\u9593\u6233\u8A18\u3002\r\n\u4F60\u76EF\u8457\u9019\u4E9B\u8CC7\u8A0A\uFF0C\u7A81\u7136\u60F3\u5230\u2014\u2014\r\n\r\n\u4F60\u5728\u592A\u7A7A\u8259\u770B\u5230\u7684\u90A3\u4E32\u7DE8\u865F\u3002\r\n\r\n\u4F60\u4E5F\u8A31\u53EF\u4EE5\u628A\u5B83\u8A18\u9304\u4E0B\u4F86\uFF0C\u6216\u8A31\u54EA\u5929\u80FD\u627E\u5230\u5B83\u7684\u610F\u7FA9\u3002"
  typingSpeed: 0.05
