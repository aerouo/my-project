--- !u!114 &1915700029
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1915700027}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b14c787e34fae5c40b47d594c5e8e631, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level1Manager
  dialogueText: {fileID: 835394274}
  backgroundImage: {fileID: 384862595}
  storyPart1: "\u6050\u61FC\u9000\u53BB\u5F8C\u7684\u75B2\u618A\u611F\u731B\u5730\u6E67\u4E0A\u4F86\u3002\r\n\r\n\u6A58\u5B50\u76AE\u7684\u5C0F\u5C4B\u88E1\u7570\u5E38\u5B89\u975C\uFF0C\u537B\u8B93\u4EBA\u610F\u5916\u5730\u5B89\u5FC3\u3002\r\n\u90A3\u662F\u4E00\u7A2E\u50CF\u4E45\u9055\u7684\u5BB6\u7684\u5473\u9053\uFF0C\u8B93\u4F60\u5168\u8EAB\u7684\u529B\u6C23\u90FD\u653E\u4E0B\u4F86\u3002\r\n\r\n\u5495\u5695\u2014\u2014\r\n\u4F60\u7684\u809A\u5B50\u5728\u7A7A\u8569\u7684\u623F\u9593\u88E1\u97FF\u5F97\u7279\u5225\u5927\u8072\u3002\r\n\r\n\u6A58\u5B50\u76AE\u8F15\u8F15\u7684\u7B11\u4E86\uFF0C\u7ACB\u523B\u5F9E\u89D2\u843D\u642C\u51FA\u4E00\u500B\u7834\u7834\u7684\u5C0F\u6728\u76D2\u3002\r\n\r\n\u88E1\u982D\u653E\u8457\u4E00\u4E9B\u4F60\u5F9E\u672A\u898B\u904E\u7684\u679C\u5BE6\u8207\u91CE\u83DC\uFF0C\u5927\u90E8\u5206\u5916\u8868\u4E0D\u592A\u597D\u770B\uFF1A\r\n\u6709\u4E9B\u88C2\u958B\u3001\u6709\u4E9B\u88AB\u87F2\u54AC\u3001\u6709\u4E9B\u8EDF\u721B\u3002\r\n\u4F46\u9999\u6C23\u537B\u5F88\u81EA\u7136\uFF0C\u5E36\u8457\u4E00\u9EDE\u5FAE\u751C\u7684\u5473\u9053\u3002"
  storyPart2: "\u4F60\u5DF2\u7D93\u53C8\u7D2F\u53C8\u9913\uFF0C\u6839\u672C\u7121\u6687\u6311\u5254\u3002\r\n\u4E00\u908A\u611F\u8B1D\u6A58\u5B50\u76AE\uFF0C\u4E00\u908A\u6BEB\u4E0D\u9867\u5F62\u8C61\u5730\u5927\u53E3\u5403\u8457\u3002\r\n\r\n\u4F60\uFF1A\u300C\u6A58\u5B50\u76AE\u2026\u2026\u9019\u4E9B\u679C\u5BE6\u4F60\u600E\u9EBC\u63A1\u7684\uFF1F\u4F60\u9019\u9EBC\u5C0F\u2026\u2026\u300D\r\n\u4F60\u6CE8\u610F\u5230\u4ED6\u8EAB\u4E0A\u90A3\u4E9B\u7D30\u5C0F\u7684\u6293\u75D5\u8207\u7600\u9752\uFF0C\u5FC3\u50CF\u88AB\u63EA\u4E86\u4E00\u4E0B\u3002\r\n\r\n\u6A58\u5B50\u76AE\uFF1A\u300C\u6211\u6C92\u4E8B\u7684\uFF01\u300D\r\n\u4ED6\u7B11\u5F97\u50CF\u500B\u592A\u967D\uFF0C\u5C3E\u5DF4\u8208\u596E\u5730\u6643\u4F86\u6643\u53BB\u3002\r\n\u6A58\u5B50\u76AE\uFF1A\u300C\u6211\u9084\u53EF\u4EE5\u6559\u4F60\u63A1\uFF01\u5F88\u7C21\u55AE\u7684\uFF01\u300D\r\n\n[\u63DB\u5716]\n\r\n\u4ED6\u62C9\u8D77\u4F60\u7684\u624B\uFF0C\u4E00\u8DEF\u5E36\u5230\u5C0F\u5C4B\u5F8C\u65B9\u7684\u68EE\u6797\u6DF1\u8655\u3002\r\n\u6A58\u5B50\u76AE\u6B65\u4F10\u8F15\u76C8\uFF0C\u537B\u5341\u5206\u8B39\u614E\uFF0C\u50CF\u662F\u719F\u6089\u9019\u7247\u5371\u96AA\u4E4B\u5730\u7684\u6BCF\u4E00\u5BF8\u571F\u5730\u3002\r\n\r\n\u9060\u8655\u7684\u6A39\u8449\u90FD\u662F\u67AF\u9EC3\u908A\u7DA0\uFF0C\u50CF\u88AB\u67D0\u7A2E\u75C5\u83CC\u4FB5\u8755\u904E\u3002\r\n\u7A7A\u6C23\u98C4\u8457\u6DE1\u6DE1\u7684\u91D1\u5C6C\u5473\uFF0C\u4F60\u4E0D\u7531\u5F97\u76BA\u8D77\u7709\u982D\u3002\r\n\r\n\u6A58\u5B50\u76AE\uFF1A\u300C\u56E0\u70BA\u9019\u88E1\u4EE5\u524D\u88AB\u6C61\u67D3\u904E\u3002\u300D\r\n\u4ED6\u7AD9\u5728\u4E00\u68F5\u6A39\u4E0B\uFF0C\u6307\u8457\u679D\u982D\u7684\u679C\u5BE6\u3002\r\n\u6A58\u5B50\u76AE\uFF1A\u300C\u6240\u4EE5\u770B\u8D77\u4F86\u5F88\u6F02\u4EAE\u3001\u5B8C\u6574\u7684\u53CD\u800C\u662F\u4E0D\u80FD\u5403\u7684\u3002\u300D\r\n\u6A58\u5B50\u76AE\uFF1A\u300C\u771F\u6B63\u80FD\u5403\u7684\uFF0C\u53CD\u800C\u662F\u6709\u9EDE\u87F2\u86C0\u7684\u3002\u300D\r\n\r\n\u4F60\u671B\u8457\u5169\u9846\u679C\u5BE6\u2014\u2014\r\n\u4E00\u9846\u5B8C\u7F8E\u7121\u7F3A\uFF0C\u4EAE\u5F97\u50CF\u5047\u7684\u3002\r\n\u53E6\u4E00\u9846\u5751\u5751\u5DF4\u5DF4\uFF0C\u4E0A\u9762\u9084\u6709\u87F2\u54AC\u904E\u7684\u75D5\u8DE1\u3002\r\n\r\n\u6A58\u5B50\u76AE\u7728\u8457\u773C\uFF0C\u671F\u5F85\u4F60\u505A\u51FA\u6B63\u78BA\u9078\u64C7\u3002"
  typingSpeed: 0.05
  waitBeforeStory: 0.5
  timeBetweenLines: 1.5
